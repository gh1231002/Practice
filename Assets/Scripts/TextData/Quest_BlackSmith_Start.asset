  m_Name: Quest_BlackSmith_Start
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  NpcName: "\uD37C\uAC70\uC2A4"
  Dialogues:
  - "\uB0B4\uAC00 \uC774 \uB9C8\uC744 \uCD5C\uACE0\uC758 \uB300\uC7A5\uC7A5\uC774
    \uD37C\uAC70\uC2A4\uB77C\uB124!\n\uBB34\uC2A8 \uC77C\uB85C \uCC3E\uC544\uC654\uB294\uAC00?"
  - "\uC74C? \uBD88\uD0A4\uAC00 \uBCF4\uB0B4\uC11C \uC654\uB2E4\uACE0?\n\uADF8 \uC778\uAC04\uC774
    \uB2F9\uC2E0\uC774 \uB9C8\uC74C\uC5D0 \uB4E4\uC5C8\uB098 \uBCF4\uAD6C\uB9CC!"
  - "\uC790 \uC5EC\uAE30 \uC4F8\uB9CC\uD55C \uBB34\uAE30\uB4E4\uC774\uB124.\n\uC774
    \uC911\uC5D0 \uD558\uB098 \uACE8\uB77C\uBCF4\uAC8C\uB098."
  - "\uADF8 \uBB34\uAE30\uB97C \uACE8\uB790\uAD6C\uB9CC!\n\uB2F9\uC2E0\uC5D0\uAC8C
    \uC798 \uC5B4\uC6B8\uB9AC\uB294 \uBB34\uAE30\uAD6C\uB9CC!"
  - "\uBD88\uD0A4\uC5D0\uAC8C \uB3CC\uC544\uAC00\uBCF4\uAC8C.\n\uADF8 \uCE5C\uAD6C\uD55C\uD14C
    \uB2E4\uC74C\uC5D0 \uC220 \uD55C\uC794\uD558\uC790\uACE0 \uC804\uD574\uC8FC\uACE0."
