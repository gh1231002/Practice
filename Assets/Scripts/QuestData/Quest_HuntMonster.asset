  m_Name: Quest_HuntMonster
  m_EditorClassIdentifier: Assembly-CSharp::QuestData
  QuestTitle: "\uBAAC\uC2A4\uD130 \uD1A0\uBC8C"
  QuestScription: "\uD3EC\uD0C8\uC744 \uD0C0\uACE0 \uBAAC\uC2A4\uD130\uB97C \uD1A0\uBC8C\uD558\uACE0
    \uB3CC\uC544\uC624\uC790."
  Type: 1
  TargetCount: 10
  ParentQuest: {fileID: 0}
  StartNpcName: Npc_Guard
  TargetNpcName: Npc_Guard
  StartDialogues:
  - "\uD37C\uAC70\uC2A4\uAC00 \uD55C\uC794\uD558\uC790\uACE0 \uD588\uB2E4\uACE0?\n\uD558...
    \uADF8 \uC790\uC2DD \uC774\uBC88\uC5D4 \uC5BC\uB9C8\uB098 \uB9C8\uC2DC\uB824\uACE0."
  - "\uC544\uBB34\uD2BC \uC774\uC81C \uBB34\uAE30\uB3C4 \uC5BB\uC5C8\uC73C\uB2C8
    \uC774\uC81C \uBAAC\uC2A4\uD130\uB97C \uC7A1\uC544\uC57C\uACA0\uC9C0."
  - "\uC694\uC998 \uC774 \uADFC\uBC29\uC5D0\uC11C \uBAAC\uC2A4\uD130 \uAC1C\uCCB4
    \uC218\uAC00 \uB298\uC5B4\uB098\uC11C\n\uB9C8\uC744\uC758 \uACBD\uBE44\uBCD1
    \uC218\uB85C\uB294 \uAC10\uB2F9\uC774 \uD798\uB4E0 \uC218\uC900\uAE4C\uC9C0 \uC654\uB2E4\uB124"
  - "\uC790\uB124\uAC00 \uC880 \uB3C4\uC640\uC8FC\uBA74 \uC88B\uC744\uAC70 \uAC19\uC740\uB370.\n\uB4A4\uC5D0
    \uBCF4\uC774\uB294 \uD3EC\uD0C8\uB85C \uAC00\uC11C \uAC1C\uCCB4 \uC218\uB97C
    \uC904\uC774\uACE0 \uC640\uC8FC\uAC8C."
  RemindDialogues:
  - "\uD55C \uBA85\uC774\uB77C\uB3C4 \uC544\uC26C\uC6B4 \uC0C1\uD669\uC774\uB2C8
    \uC5BC\uB978 \uAC00\uAC8C."
  CompleteDialogues:
  - "\uC74C. \uBAAC\uC2A4\uD130\uB97C \uB2E4 \uC7A1\uACE0 \uC654\uB098\uBCF4\uAD6C"
