  QuestTitle: "\uBD88\uD0A4\uC5D0\uAC8C \uB3CC\uC544\uAC00\uAE30"
  QuestScription: "\uACBD\uBE44\uB300\uC7A5\uC778 \uBD88\uD0A4\uC5D0\uAC8C \uB3CC\uC544\uAC00\uC790."
  Type: 0
  TargetCount: 1
  ParentQuest: {fileID: 11400000, guid: cf230c27177e3a0418665d9381833863, type: 2}
  StartNpcName: Npc_BlackSmith
  TargetNpcName: Npc_Guard
  StartDialogues:
  - "\uADF8 \uC778\uAC04\uC774 \uC0AC\uB78C\uC744 \uCD94\uCC9C\uC744 \uD558\uB2E4\uB2C8
    \uC624\uB79C\uB9CC\uC774\uAD6C\uB9CC."
  - "\uC774 \uB9C8\uC744\uC5D0 \uC628\uAC78 \uD658\uC601\uD558\uB124 \uC2E0\uCC38.\n\uC628
    \uAE30\uB150\uC73C\uB85C \uC120\uBB3C\uC744 \uD558\uB098 \uC8FC\uAC9F\uB124."
  - "\uC606\uC5D0 \uBCF4\uBA74 \uBB34\uAE30\uB4E4\uC774 \uBAA8\uC5EC\uC788\uB294
    \uACF3\uC774 \uBCF4\uC774\uB294\uAC00?\n\uAC70\uAE30\uC11C \uC6D0\uD558\uB294
    \uBB34\uAE30 \uD558\uB098 \uACE8\uB77C\uBCF4\uAC8C\uB098 \uC120\uBB3C\uC77C\uC138"
  - "\uC774\uC81C \uBD88\uC5D0\uAC8C \uB3CC\uC544\uAC00\uBCF4\uAC8C.\n\uADF8 \uCE5C\uAD6C\uD55C\uD14C
    \uB2E4\uC74C\uC5D0 \uC220 \uD55C\uC794\uD558\uC790\uACE0 \uC804\uD574\uC8FC\uACE0."
  RemindDialogues:
  - "\uC544\uC9C1 \uBD88\uD0A4\uD55C\uD14C \uC548\uAC14\uB098?\n\uC5BC\uB978 \uAC00\uBCF4\uC2DC\uAC8C."
  CompleteDialogues:
  - "\uBB34\uAE30\uB294 \uC798 \uBC1B\uACE0 \uB3CC\uC544\uC654\uB098?"
