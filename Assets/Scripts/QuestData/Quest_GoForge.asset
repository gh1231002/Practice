  m_Script: {fileID: 11500000, guid: 7bcef0448282b4c4cb474adb0e274fca, type: 3}
  m_Name: Quest_GoForge
  m_EditorClassIdentifier: Assembly-CSharp::QuestData
  QuestTitle: "\uB300\uC7A5\uAC04 \uCC3E\uC544\uAC00\uAE30"
  QuestScription: "\uB9C8\uC744 \uB300\uC7A5\uAC04\uC744 \uCC3E\uC544\uAC00\uBCF4\uC790."
  Type: 0
  TargetCount: 1
  ParentQuest: {fileID: 0}
  StartNpcName: Npc_Guard
  TargetNpcName: Npc_BlackSmith
  StartDialogues:
  - "\uC74C? \uB0AF\uC120 \uC5BC\uAD74\uC774\uAD70. \uC774 \uB9C8\uC744\uC5D0\uB294
    \uBB34\uC2A8 \uC77C\uB85C \uC628\uAC70\uC9C0?"
  - "\uBAA8\uD5D8\uC744 \uD558\uACE0 \uC2F6\uC5B4\uC11C \uC654\uB2E4\uACE0?\n\uD558!
    \uC9C0\uAE08 \uB108\uC758 \uBAA8\uC2B5\uC744 \uBD10\uB77C \uB9E8 \uBAB8\uC73C\uB85C
    \uBB58 \uD560 \uC218 \uC788\uB2E4\uB294\uAC70\uC9C0? "
  - "\uAD50\uD68C \uB4A4 \uCABD\uC5D0 \uC788\uB294 \uB300\uC7A5\uAC04\uC5D0 \uAC00\uC11C
    \uB300\uC7A5\uC7A5\uC774\uC5D0\uAC8C \uB9D0\uC744 \uAC78\uC5B4\uBD10\uB77C.\n\uACBD\uBE44\uB300\uC7A5\uC774
    \uBCF4\uB0C8\uB2E4\uACE0\uD558\uBA74 \uBB34\uAE30 \uD558\uB098 \uCC59\uACA8\uC904\uAC70\uB2E4."
  - "\uADF8 \uBB34\uAE30\uB97C \uBC1B\uACE0 \uB098\uC5D0\uAC8C \uB2E4\uC2DC \uB3CC\uC544\uC640\uB77C.\n\uB108\uC5D0\uAC8C
    \uB9DE\uB294 \uC784\uBB34\uB97C \uC8FC\uB3C4\uB85D \uD558\uC9C0."
  RemindDialogues:
  - "\uC544\uC9C1\uB3C4 \uC548\uAC14\uB098?\n\uADF8\uB807\uAC8C \uB290\uB824\uC11C\uC57C
    \uBAA8\uD5D8\uC774\uB098 \uC81C\uB300\uB85C \uD560 \uC218 \uC788\uACA0\uB098
    \uC790\uB124?"
  CompleteDialogues:
  - "\uC74C? \uBD88\uD0A4\uAC00 \uBCF4\uB0B4\uC11C \uC654\uB2E4\uACE0?"
