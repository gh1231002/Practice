  TargetNpcName: Npc_BlackSmith
  StartDialogues:
  - "\uCC98\uC74C\uBCF4\uB294 \uC5BC\uAD74\uC778\uB370 \uC774 \uB9C8\uC744\uC5D0\uB294
    \uBB34\uC2A8 \uC77C\uB85C \uC628\uAC70\uC9C0?"
  - "\uBAA8\uD5D8\uC744 \uD558\uACE0 \uC2F6\uC5B4\uC11C \uC654\uB2E4\uACE0?\n\uADF8\uB7F0\uB370
    \uB4E4\uACE0 \uC788\uB294 \uBB34\uAE30\uB294 \uC5C6\uC5B4 \uBCF4\uC774\uB294\uAD70. "
  - "\uB300\uC7A5\uAC04\uC5D0 \uAC00\uC11C \uB300\uC7A5\uC7A5\uC774\uC5D0\uAC8C \uB9D0\uC744
    \uAC78\uC5B4\uBD10\uB77C.\n\uACBD\uBE44\uB300\uC7A5\uC774 \uBCF4\uB0C8\uB2E4\uACE0\uD558\uBA74
    \uBB34\uAE30 \uD558\uB098 \uCC59\uACA8\uC904\uAC70\uB2E4."
  - "\uADF8 \uBB34\uAE30\uB97C \uBC1B\uACE0 \uB3CC\uC544\uC624\uBA74 \uBBF8\uC158\uC744
    \uD558\uB098 \uC8FC\uC9C0."
  RemindDialogues:
  - "\uC544\uC9C1 \uC548\uAC14\uB098?\n\uB300\uC7A5\uAC04\uC740 \uB208\uC5D0 \uC798
    \uB744\uB2C8 \uC798 \uCC3E\uC544\uBD10\uB77C."
  CompleteDialogues:
  - "\uC74C? \uB204\uAC00 \uBCF4\uB0B4\uC11C \uC654\uB2E4\uACE0?"
