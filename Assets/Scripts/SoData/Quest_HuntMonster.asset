  m_EditorClassIdentifier: Assembly-CSharp::QuestData
  QuestTitle: "\uBAAC\uC2A4\uD130 \uD1A0\uBC8C"
  QuestScription: "\uD3EC\uD0C8\uC744 \uD0C0\uACE0 \uBAAC\uC2A4\uD130\uB97C \uD1A0\uBC8C\uD558\uACE0
    \uB3CC\uC544\uC624\uC790."
  Type: 1
  TargetMonster: 0
  TargetCount: 5
  ParentQuest: {fileID: 11400000, guid: 7875095731bc16e4599fa08f793ffbfa, type: 2}
  StartNpcName: Npc_Guard
  TargetNpcName: Npc_Guard
  StartDialogues:
  - "\uC774\uC81C \uBB34\uAE30\uB3C4 \uC5BB\uC5C8\uC73C\uB2C8 \uC790\uB124\uC5D0\uAC8C
    \uBD80\uD0C1\uC774 \uD558\uB098 \uC788\uB124."
  - "\uC694\uC998 \uD3D0\uAD50\uD68C\uC5D0\uC11C \uBAAC\uC2A4\uD130\uAC00 \uB098\uD0C0\uB098\uACE0
    \uC788\uB2E4\uB294 \uC81C\uBCF4\uAC00 \uC788\uC5C8\uB124\n\uC870\uC0AC\uB97C
    \uC704\uD574 \uC790\uB124\uAC00 \uD55C\uBC88 \uAC00\uC92C\uC73C\uBA74 \uD558\uB294\uB370"
  - "\uB9CC\uC57D \uBAAC\uC2A4\uD130\uAC00 \uC788\uB2E4\uBA74 \uD1A0\uBC8C\uAE4C\uC9C0
    \uBD80\uD0C1\uD558\uB124."
  RemindDialogues:
  - "\uBE60\uB978 \uD655\uC778\uC744 \uBD80\uD0C1\uD558\uB124."
  CompleteDialogues:
  - "\uC0C1\uD669\uC740 \uC5B4\uB560\uB098?\n\uBE0C\uB9AC\uD551 \uBD80\uD0C1\uD558\uB124."
  - "\uBAAC\uC2A4\uD130 \uAC1C\uCCB4 \uC218\uAC00 \uB9CE\uC544 \uAC1C\uCCB4 \uC218\uB97C
    \uC904\uC774\uACE0 \uC654\uB2E4\uACE0?\n\uC0AC\uB0E5\uC744 \uD55C\uAC74 \uC88B\uC9C0\uB9CC
    \uC790\uB124\uB294 \uC544\uC9C1 \uC2E0\uC785\uC77C\uC138.\n\uB2E4\uC74C\uC5D4
    \uC880 \uB354 \uC870\uC2EC\uD558\uAC8C\uB098."
  - "\uBAAC\uC2A4\uD130\uB97C \uC0AC\uB0E5\uD588\uC73C\uB2C8 \uC778\uBCA4\uD1A0\uB9AC\uB97C
    \uD55C\uBC88 \uD655\uC778\uD574\uBCF4\uAC8C.\n\uAC15\uD574\uC9C8 \uC218 \uC788\uB294
    \uBC29\uBC95\uC744 \uC54C\uB824\uC8FC\uC9C0."
  isChoiceDialogue: 0
  ChoiceDialogueIndex: 0
  Choices: []
